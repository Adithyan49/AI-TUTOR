rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zarazyannaenterprises@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.id is string && isValidId(data.id) &&
        data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.learningStreak is number && data.learningStreak >= 0 &&
        data.totalXp is number && data.totalXp >= 0 &&
        data.selectedLearningPath in ['beginner', 'intermediate', 'advanced'] &&
        data.completedLessons is list && data.completedLessons.size() <= 500 &&
        data.completedChallenges is list && data.completedChallenges.size() <= 500 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidUserCircuit(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.numQubits is number && data.numQubits >= 1 && data.numQubits <= 8 &&
        data.gatesJson is string && data.gatesJson.size() <= 50000 &&
        data.description is string && data.description.size() <= 500 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSharedExperiment(data) {
      return data.id is string && isValidId(data.id) &&
        data.authorId is string && data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.description is string && data.description.size() <= 1000 &&
        data.circuitJson is string && data.circuitJson.size() <= 50000 &&
        data.likesCount is number && data.likesCount >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().keys().hasAll(['id', 'email', 'displayName', 'learningStreak', 'totalXp', 'selectedLearningPath', 'completedLessons', 'completedChallenges', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['id', 'email', 'displayName', 'learningStreak', 'totalXp', 'selectedLearningPath', 'completedLessons', 'completedChallenges', 'createdAt', 'updatedAt']);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'learningStreak', 'totalXp', 'selectedLearningPath', 'completedLessons', 'completedChallenges', 'updatedAt']);
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);

      match /circuits/{circuitId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(circuitId);
        allow list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(circuitId) &&
          isValidUserCircuit(incoming(), userId) &&
          incoming().keys().hasAll(['id', 'userId', 'name', 'numQubits', 'gatesJson', 'description', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['id', 'userId', 'name', 'numQubits', 'gatesJson', 'description', 'createdAt', 'updatedAt']);
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(circuitId) &&
          isValidUserCircuit(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'numQubits', 'gatesJson', 'description', 'updatedAt']);
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(circuitId);
      }
    }

    match /shared_experiments/{experimentId} {
      allow get: if isValidId(experimentId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(experimentId) &&
        isValidSharedExperiment(incoming()) &&
        incoming().keys().hasAll(['id', 'authorId', 'authorName', 'title', 'description', 'circuitJson', 'likesCount', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['id', 'authorId', 'authorName', 'title', 'description', 'circuitJson', 'likesCount', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() && isValidId(experimentId) &&
        isValidSharedExperiment(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt && (
          (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'circuitJson', 'likesCount', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])) ||
          isAdmin()
        );
      allow delete: if (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin())) && isValidId(experimentId);
    }
  }
}
